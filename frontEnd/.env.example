# Variáveis de ambiente necessárias para o Firebase
# Copie este arquivo para .env e preencha com as suas chaves
# NUNCA comite o arquivo .env no repositório!

REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=

# Endereço da API do backend (padrão: http://localhost:5000/api)
REACT_APP_API_URL=http://localhost:5000/api
