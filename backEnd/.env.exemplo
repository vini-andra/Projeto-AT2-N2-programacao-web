# Variáveis de ambiente para o Firebase no Backend
# Copie este arquivo para .env e preencha com as suas chaves
# NUNCA comite o arquivo .env no repositório!

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Porta do servidor (opcional)
PORT=5000
